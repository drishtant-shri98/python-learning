3. File Extensions
ext = input("File Name: ").strip().lower()

if ext.endswith(".gif"):
    print("image/gif")
elif ext.endswith(".jpeg") | ext.endswith(".jpg"):
    print("image/jpeg")
elif ext.endswith(".png"):
    print("image/png")
elif ext.endswith(".pdf"):
    print("application/pdf")
elif ext.endswith(".txt"):
    print("text/plain")
elif ext.endswith(".zip"):
    print("application/zip")
else:
    print("application/octet-stream")


4. Math Interpreter
x, y, z = input("Expression: ").split()

x = float(x)
z = float(z)

match y:
    case "+":
        print(x+z)
    case "-":
        print(x-z)
    case "/":
        if z != 0:
            print(x/z)
        else:
            print("cannot divide by zero")
    case "*":
        print(x*z)


5. Meal Time
def main():
    time = input("What time is it? ")
    t = convert(time)

    if 7 <= t <= 8:
        print("breakfast time")
    elif 12 <= t <= 13:
        print("lunch time")
    elif 18 <= t <= 19:
        print("dinner time")

def convert(time):
    time = time.strip().lower().replace(".", "").replace(" ", "")

    is_am = time.endswith("am")
    is_pm = time.endswith("pm")
    time = time.removesuffix("am").removesuffix("pm")   # "7:30"

    hours, minutes = time.split(":")
    hours = int(hours)
    minutes = int(minutes)

    if is_pm and hours != 12:
        hours += 12        # 6 pm -> 18
    if is_am and hours == 12:
        hours = 0          # 12 am -> 0 (midnight)
    return hours + minutes / 60

if __name__ == "__main__":
    main()
