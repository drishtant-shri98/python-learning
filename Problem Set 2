4. Vanity Plates
def main():
    plate = input("Plate: ").upper()
    if is_valid(plate):
        print("Valid")
    else:
        print("Invalid")

def is_valid(s):
    if not s[0:2].isalpha():
        return False
    if not (len(s) >= 2 and len(s) <= 6):
        return False
    if not s.isalnum():
        return False
    for i in range (len(s)):
        if s[i].isdigit():
            if s[i] == "0":
                return False
            if not s[i:].isdigit():
                return False
            break

    return True

main()


